#!/usr/bin/env bash
# Quality gates before every commit. Enable with:
#   git config core.hooksPath qupath-rs/.githooks   (inside the QuPath fork)
#   git config core.hooksPath .githooks             (standalone checkout)
set -euo pipefail
project="$(cd "$(dirname "$0")/.." && pwd)"
top="$(git rev-parse --show-toplevel)"
rel="${project#"$top"}"; rel="${rel#/}"
staged="$(git diff --cached --name-only)"
if echo "$staged" | grep -E '(^|/)\.env($|\.)' | grep -qv '\.env\.example$'; then
  echo "pre-commit: refusing to commit .env files" >&2; exit 1
fi
if git diff --cached -U0 | grep -qiE '^\+.*(api[_-]?key|secret|password|token)\s*[:=]\s*["'"'"'][^"'"'"']{8,}'; then
  echo "pre-commit: staged changes look like they contain a secret" >&2; exit 1
fi
# Only run the Rust gates when the Rust project changes.
if [ -n "$rel" ] && ! echo "$staged" | grep -q "^$rel/"; then exit 0; fi
cd "$project"
cargo fmt --check
cargo clippy --all-targets -- -D warnings
cargo test --release --quiet
scripts/check-sizes.sh
