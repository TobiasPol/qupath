# Optional settings for qupath-rs. Copy to .env and adjust; .env is never committed.

# Log filter (overrides the default "warn,qupath=info,qupath_rs=info")
RUST_LOG=

# Path to libopenslide (.dylib/.so/.dll) for vendor formats (NDPI, MRXS, SCN...).
# When unset, standard install locations and an installed QuPath app are searched.
QUPATH_RS_OPENSLIDE=

# Scripted run for screenshots/regression checks, e.g.
# "zoom:2; rect:11000,8000,2000,2000; cmd:PositiveCellDetection; accept; shot:/tmp/a.png; quit"
QUPATH_RS_AUTOMATION=

# qupath-rs binary for the AI agent plugin launcher (plugin/scripts/qupath-rs-mcp).
# When unset, PATH, ~/.cargo/bin, QuPath-rs.app and this checkout's target/release are searched.
QUPATH_RS_BIN=
